/dist/
.DS_Store

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md

# Docs: only README/PROJECT_STATE and docs/**/*.md are tracked; docs images stay local
*.md
!README.md
!PROJECT_STATE.md
!docs/**/*.md
!internal/prompt/defaultprompt.md
docs/**/*.png
docs/**/*.jpg

# Local verification tools (judgement reverse-engineering, results live in data/desktop-task-protocol.md)
/cmd/desktopverify*/
/.qa/
/.qa-*/
/.qa-linux/
/release/
/demo-data/
/.deploy-verify/
.d2b-data/
.d2b-shots/
.d2b-shots/profile*/

# Vendored meta package binaries
/third_party/meta/bin/

# -----------------------------------------------------------------------------
# Release hygiene & local scratch files
# -----------------------------------------------------------------------------

# Editor/tooling numeric backup files (e.g. *.go.<digits>, *.test.<digits>)
*.[0-9][0-9][0-9]*
*.go.[0-9]*
*.test.[0-9]*
*.json.[0-9]*
*.js.[0-9]*
*.mjs.[0-9]*
*.html.[0-9]*
*.css.[0-9]*
*.cmd.[0-9]*
*.sh.[0-9]*
*.md.[0-9]*

# Local dev scratch, bypass copies, and patches
/work/
/panel-assets/
/logs/
/spool/
/state/
/usage/
*.patch
.patch

# Test binaries and profiles
*.test
*.test.exe
*.prof
*.out
coverage.out
